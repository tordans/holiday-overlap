{
  "name": "holiday-overlap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "bun run --parallel type-check:*",
    "type-check:app": "tsc --noEmit -p tsconfig.app.json",
    "type-check:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test": "vitest run --passWithNoTests",
    "knip": "KNIP_STRICT=1 knip --config knip.config.mjs",
    "knip-warn": "knip --config knip.config.mjs || true",
    "check": "bun run --parallel type-check lint format test knip-warn",
    "check-ci": "bun run --parallel type-check lint-check format-check test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-router": "^1.170.44",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lz-string": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.45",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "browserslist": "^4.29.3",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint-plugin-compat": "^7.0.2",
    "knip": "^6.41.0",
    "oxc-transform-react": "^0.152.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not op_mini all",
    "not kaios > 0"
  ],
  "trustedDependencies": [
    "eslint-plugin-compat"
  ]
}
